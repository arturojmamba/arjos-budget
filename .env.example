# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Trading 212 API key and secret (Trading 212 app → Settings → API).
# Give the key read-only permissions; this app only sends GET requests.
T212_API_KEY=
T212_API_SECRET=

# Optional overrides
# PORT=4545
# FINANCE_DB=data/finance.db
# FINANCE_BACKUPS=data/backups

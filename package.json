{
  "name": "finance-app",
  "version": "1.4.3",
  "private": true,
  "description": "Local-first personal finance and budgeting app",
  "author": "arjos-budget",
  "repository": {
    "type": "git",
    "url": "https://github.com/arturojmamba/arjos-budget.git"
  },
  "main": "dist-electron/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch & node --disable-warning=ExperimentalWarning --import tsx --watch-path=server server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "npm run build && node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "backup": "node --disable-warning=ExperimentalWarning --import tsx scripts/backup.ts",
    "demo": "node --disable-warning=ExperimentalWarning --import tsx scripts/demo.ts data/demo.db",
    "start:demo": "npm run build && FINANCE_DB=data/demo.db FINANCE_BACKUPS=data/demo-backups T212_API_KEY=demo T212_API_SECRET=demo T212_SYNC=off PORT=4546 node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "desktop:bundle": "node scripts/build-desktop.mjs",
    "desktop": "npm run build && npm run desktop:bundle && electron .",
    "desktop:mac": "npm run build && npm run desktop:bundle && electron-builder --mac --publish never",
    "desktop:win": "npm run build && npm run desktop:bundle && electron-builder --win --publish never"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "app.ledger.desktop",
    "productName": "Coil",
    "copyright": "Personal use",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.mjs"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Ledger-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Coil ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Ledger-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Coil"
    },
    "publish": null
  }
}
